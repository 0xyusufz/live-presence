{
  "name": "@live-presence/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "start": "node --env-file=../.env --import=tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "access:grant": "node --env-file-if-exists=../.env --import=tsx src/cli/access-main.ts grant",
    "access:revoke": "node --env-file-if-exists=../.env --import=tsx src/cli/access-main.ts revoke"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
