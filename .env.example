# Cloudflare Realtime TURN credentials. Keep real values in an ignored .env file.
CLOUDFLARE_TURN_KEY_ID=replace-with-cloudflare-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=replace-with-cloudflare-api-token

# Short-lived credentials should cover the expected session duration.
TURN_CREDENTIAL_TTL_SECONDS=86400

# Optional public STUN override. Comma-separated stun: or stuns: URLs.
STUN_URLS=stun:stun.l.google.com:19302

# Optional self-hosted coturn deployment. These are used only by
# infra/docker-compose.yml and are not required by the active Cloudflare path.
TURN_REALM=turn.example.com
TURN_SHARED_SECRET=replace-with-self-hosted-coturn-shared-secret
TURN_EXTERNAL_IP=203.0.113.10
